#!/bin/bash
# Fake ssh-keygen — generates an Ed25519 key in OpenSSH format via Python.
# Satisfies gh's `ssh-keygen -t ed25519 -N "" -f <path> -C "..."` call without
# requiring a real ssh-keygen binary.
#
# Args: -t <type> -N <passphrase> -f <path> -C <comment>
# We always generate Ed25519 (codespace SSH server accepts it; russh-keys
# can load OpenSSH-format Ed25519 keys).

if [[ "$1" == "-t" ]]; then
  shift; KTYPE="$1"; shift
  KFILE=""
  KCOMMENT=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f) shift; KFILE="$1" ;;
      -N) shift ;;  # passphrase (we ignore)
      -C) shift; KCOMMENT="$1" ;;
      -q) ;;
    esac
    shift
  done
  if [[ -n "$KFILE" ]]; then
    python3 - "$KFILE" "$KCOMMENT" << 'PYKEYGEN' 2>/dev/null
from cryptography.hazmat.primitives.asymmetric import ed25519
from cryptography.hazmat.primitives import serialization
import sys, os

private_key = ed25519.Ed25519PrivateKey.generate()
pem = private_key.private_bytes(
    encoding=serialization.Encoding.PEM,
    format=serialization.PrivateFormat.OpenSSH,
    encryption_algorithm=serialization.NoEncryption(),
)
with open(sys.argv[1], 'wb') as f:
    f.write(pem)
os.chmod(sys.argv[1], 0o600)

public_key = private_key.public_key()
ssh = public_key.public_bytes(
    encoding=serialization.Encoding.OpenSSH,
    format=serialization.PublicFormat.OpenSSH,
).decode()

if len(sys.argv) > 2 and sys.argv[2]:
    ssh += ' ' + sys.argv[2]
ssh += '\n'

with open(sys.argv[1] + '.pub', 'w') as f:
    f.write(ssh)
print(ssh, end='')
PYKEYGEN
    exit 0
  fi
fi
exit 0
